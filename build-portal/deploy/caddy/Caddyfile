{
  admin off
  auto_https off
}
:8443 {
  tls /etc/zhanlu-tls/tls.crt /etc/zhanlu-tls/tls.key
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "same-origin"
  }
  reverse_proxy 127.0.0.1:3000
}
