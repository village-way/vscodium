# syntax=docker/dockerfile:1.7
FROM node:22.22.0-bookworm-slim AS tools
ARG GH_VERSION=2.97.0
ARG GLAB_VERSION=1.101.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" | tar -xz \
 && mv "gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
 && curl -fsSL "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin bin/glab --strip-components=1

FROM node:22.22.0-bookworm-slim AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/github-app/package.json packages/github-app/package.json
COPY packages/release-runner/package.json packages/release-runner/package.json
RUN pnpm install --frozen-lockfile
COPY apps/worker apps/worker
COPY packages/contracts packages/contracts
COPY packages/db packages/db
COPY packages/github-app packages/github-app
COPY packages/release-runner packages/release-runner
RUN pnpm --filter @zhanlu/build-portal-contracts build && pnpm --filter @zhanlu/build-portal-db build && pnpm --filter @zhanlu/build-portal-github-app build && pnpm --filter @zhanlu/build-portal-release-runner build && pnpm --filter @zhanlu/build-portal-worker build \
 && pnpm --filter @zhanlu/build-portal-worker deploy --prod --legacy /out/worker

FROM node:22.22.0-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates git jq openssh-client python3 tar tini && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 zhanlu && useradd --uid 10001 --gid 10001 --create-home zhanlu \
 && mkdir -p /var/lib/zhanlu-build /run/zhanlu-credentials && chown -R 10001:10001 /var/lib/zhanlu-build /run/zhanlu-credentials
COPY --from=tools /usr/local/bin/gh /usr/local/bin/gh
COPY --from=tools /usr/local/bin/glab /usr/local/bin/glab
COPY --from=build /out/worker /app
COPY deploy/scripts/gitlab-credential-helper.sh /usr/local/bin/zhanlu-gitlab-credential
RUN chmod 0755 /usr/local/bin/zhanlu-gitlab-credential
ENV NODE_ENV=production APP_COMPONENT=worker GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=credential.https://github.com.helper GIT_CONFIG_VALUE_0="!node /app/node_modules/@zhanlu/build-portal-github-app/dist/credential-helper.js" GIT_CONFIG_KEY_1=credential.http://gitlab.cmss.com.helper GIT_CONFIG_VALUE_1="!/usr/local/bin/zhanlu-gitlab-credential"
WORKDIR /app
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","dist/index.js"]
